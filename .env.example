# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no credentials are stored here.

# --- Optional ---
# PLAYWRIGHT_CHANNEL=msedge             # auto (Chrome then Chromium), msedge, chrome, chromium
# Explicit msedge uses session/profile-msedge by default; sign in again after switching.
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
# DEEPSEEK_PROXY=socks5://127.0.0.1:9090  # optional; no credentials; browser and HTTPX
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=30               # per-client-IP limit on /v1 endpoints
# TRUST_PROXY_HEADERS=0                 # 1 = rate-limit by X-Forwarded-For (only behind a proxy)

# MAX_PROMPT_CHARS=80000                # local test limit, not a DeepSeek context guarantee
